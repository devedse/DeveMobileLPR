<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="DeveMobileLPR.App.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:styles="clr-namespace:DeveMobileLPR.App.Resources.Styles"
    xmlns:ui="clr-namespace:DeveMobileLPR.App.UI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <styles:DarkColors />
                <ResourceDictionary Source="Resources/Styles/DesignSystem.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ui:MillisecondsValueConverter x:Key="Milliseconds" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
