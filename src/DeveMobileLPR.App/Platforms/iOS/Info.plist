  <string>DeveMobileLPR uses the camera to recognize license plates locally while you drive.</string>
  <key>NSLocationWhenInUseUsageDescription</key>
  <string>DeveMobileLPR can optionally attach your location and route to locally stored trips and sightings.</string>
  <key>NSPhotoLibraryUsageDescription</key>
  <string>DeveMobileLPR uses selected videos for private, on-device license-plate analysis.</string>
  <key>XSAppIconAssets</key><string>Assets.xcassets/appicon.appiconset</string>
