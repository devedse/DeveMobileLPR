<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Layout tokens: use these instead of page-specific offsets. -->
    <x:Double x:Key="Space2">2</x:Double>
    <x:Double x:Key="Space4">4</x:Double>
    <x:Double x:Key="Space8">8</x:Double>
    <x:Double x:Key="Space12">12</x:Double>
    <x:Double x:Key="Space16">16</x:Double>
    <x:Double x:Key="Space20">20</x:Double>
    <x:Double x:Key="Space24">24</x:Double>
    <Thickness x:Key="PagePadding">16,22,16,24</Thickness>
    <Thickness x:Key="DetailPagePadding">16,18,16,14</Thickness>
    <Thickness x:Key="CardPadding">20</Thickness>
    <Thickness x:Key="CompactCardPadding">16,13</Thickness>

    <Style TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{DynamicResource Background}" />
    </Style>
    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <!-- Page and section typography. -->
    <Style x:Key="PageTitle" TargetType="Label">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>
    <Style x:Key="DetailTitle" TargetType="Label">
        <Setter Property="FontSize" Value="25" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="Label">
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>
    <Style x:Key="Eyebrow" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="1.2" />
        <Setter Property="TextColor" Value="{DynamicResource Primary}" />
        <Setter Property="TextTransform" Value="Uppercase" />
    </Style>
    <Style x:Key="SecondaryText" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>
    <Style x:Key="MutedText" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource TextMuted}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>
    <Style x:Key="SettingTitle" TargetType="Label">
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>
    <Style x:Key="SettingDescription" BasedOn="{StaticResource SecondaryText}" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="MetricValue" TargetType="Label">
        <Setter Property="FontSize" Value="27" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>
    <Style x:Key="MetricLabel" BasedOn="{StaticResource SecondaryText}" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Shared page shells. -->
    <Style x:Key="PageScrollContent" TargetType="VerticalStackLayout">
        <Setter Property="Padding" Value="{StaticResource PagePadding}" />
        <Setter Property="Spacing" Value="{StaticResource Space16}" />
    </Style>
    <Style x:Key="PageGrid" TargetType="Grid">
        <Setter Property="Padding" Value="{StaticResource PagePadding}" />
        <Setter Property="RowSpacing" Value="{StaticResource Space16}" />
    </Style>
    <Style x:Key="DetailPageGrid" TargetType="Grid">
        <Setter Property="Padding" Value="{StaticResource DetailPagePadding}" />
        <Setter Property="RowSpacing" Value="{StaticResource Space16}" />
    </Style>
    <Style x:Key="DrivePageGrid" TargetType="Grid">
        <Setter Property="Padding" Value="24,18" />
    </Style>
    <Style x:Key="CardContent" TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="{StaticResource Space12}" />
    </Style>
    <Style x:Key="DetailScrollContent" TargetType="VerticalStackLayout">
        <Setter Property="Padding" Value="0,0,0,16" />
        <Setter Property="Spacing" Value="{StaticResource Space16}" />
    </Style>
    <Style x:Key="EmptyStateText" BasedOn="{StaticResource SecondaryText}" TargetType="Label">
        <Setter Property="Margin" Value="0,30" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <!-- Card system. All standard panels share geometry from here. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource Surface}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
        <Setter Property="Stroke" Value="{DynamicResource Divider}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 22" />
    </Style>
    <Style x:Key="CompactCard" BasedOn="{StaticResource Card}" TargetType="Border">
        <Setter Property="Padding" Value="{StaticResource CompactCardPadding}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 18" />
    </Style>
    <Style x:Key="HighlightCard" BasedOn="{StaticResource Card}" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource HighlightSurface}" />
        <Setter Property="Stroke" Value="{DynamicResource HighlightStroke}" />
    </Style>
    <Style x:Key="CompactHighlightCard" BasedOn="{StaticResource HighlightCard}" TargetType="Border">
        <Setter Property="Padding" Value="{StaticResource CompactCardPadding}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 18" />
    </Style>
    <Style x:Key="InsetCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceRaised}" />
        <Setter Property="Padding" Value="14,11" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
    </Style>
    <Style x:Key="StatusCard" BasedOn="{StaticResource InsetCard}" TargetType="Border">
        <Setter Property="Stroke" Value="{DynamicResource Divider}" />
        <Setter Property="StrokeThickness" Value="1" />
    </Style>
    <Style x:Key="DividerLine" TargetType="BoxView">
        <Setter Property="Color" Value="{DynamicResource Divider}" />
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>
    <Style x:Key="PlateBadge" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource PlateYellow}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>
    <Style x:Key="PlateBadgeText" TargetType="Label">
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="TextColor" Value="{DynamicResource OnPlate}" />
    </Style>
    <Style x:Key="SmallPlateBadge" BasedOn="{StaticResource PlateBadge}" TargetType="Border">
        <Setter Property="Padding" Value="8,3" />
    </Style>
    <Style x:Key="SmallPlateBadgeText" BasedOn="{StaticResource PlateBadgeText}" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style x:Key="HeroPlateBadge" BasedOn="{StaticResource PlateBadge}" TargetType="Border">
        <Setter Property="Padding" Value="20,11" />
    </Style>
    <Style x:Key="HeroPlateBadgeText" BasedOn="{StaticResource PlateBadgeText}" TargetType="Label">
        <Setter Property="FontSize" Value="25" />
    </Style>
    <Style x:Key="BrandMark" TargetType="Border">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="HeightRequest" Value="46" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="WidthRequest" Value="46" />
    </Style>
    <Style x:Key="DriveStatusPill" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource DriveStatusSurface}" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
    </Style>
    <Style x:Key="DriveReadyCard" BasedOn="{StaticResource Card}" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource DriveReadySurface}" />
        <Setter Property="Padding" Value="30" />
        <Setter Property="StrokeShape" Value="RoundRectangle 28" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="MaximumWidthRequest" Value="570" />
    </Style>
    <Style x:Key="DriveControlCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource DrivePanel}" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Stroke" Value="{DynamicResource Divider}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 18" />
    </Style>
    <Style x:Key="DriveMetricCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource DriveMetric}" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="WidthRequest" Value="92" />
    </Style>
    <Style x:Key="DriveLatestCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource DriveLatest}" />
        <Setter Property="Padding" Value="15,8" />
        <Setter Property="Stroke" Value="{DynamicResource Divider}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="WidthRequest" Value="330" />
    </Style>
    <Style x:Key="DriveMetricValue" TargetType="Label">
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>
    <Style x:Key="DriveCaption" TargetType="Label">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="TextColor" Value="{DynamicResource TextSecondary}" />
        <Setter Property="TextTransform" Value="Uppercase" />
    </Style>
    <Style x:Key="FieldCaption" TargetType="Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextColor" Value="{DynamicResource TextMuted}" />
        <Setter Property="TextTransform" Value="Uppercase" />
    </Style>

    <!-- Buttons share one base, with small semantic variants. -->
    <Style x:Key="ButtonBase" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
        <Setter Property="TextColor" Value="{DynamicResource OnPrimary}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="HeightRequest" Value="54" />
        <Setter Property="Padding" Value="22,12" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryDark}" />
                            <Setter Property="Scale" Value="0.98" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.42" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource ButtonBase}" TargetType="Button" />
    <Style x:Key="SecondaryButton" BasedOn="{StaticResource ButtonBase}" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceRaised}" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceMuted}" />
                            <Setter Property="Scale" Value="0.98" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.42" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style x:Key="DangerButton" BasedOn="{StaticResource ButtonBase}" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource Danger}" />
        <Setter Property="TextColor" Value="{DynamicResource OnDanger}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource DangerPressed}" />
                            <Setter Property="Scale" Value="0.98" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.42" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style x:Key="CompactButton" BasedOn="{StaticResource ButtonBase}" TargetType="Button">
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style x:Key="CompactSecondaryButton" BasedOn="{StaticResource SecondaryButton}" TargetType="Button">
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style x:Key="CompactDangerButton" BasedOn="{StaticResource DangerButton}" TargetType="Button">
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style TargetType="SearchBar">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceRaised}" />
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource TextMuted}" />
        <Setter Property="CancelButtonColor" Value="{DynamicResource Primary}" />
    </Style>
    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{DynamicResource Primary}" />
        <Setter Property="ThumbColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>
    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        <Setter Property="TitleColor" Value="{DynamicResource TextMuted}" />
    </Style>
    <Style TargetType="Slider">
        <Setter Property="ThumbColor" Value="{DynamicResource Primary}" />
        <Setter Property="MinimumTrackColor" Value="{DynamicResource Primary}" />
        <Setter Property="MaximumTrackColor" Value="{DynamicResource Divider}" />
    </Style>
    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{DynamicResource Primary}" />
    </Style>
</ResourceDictionary>
