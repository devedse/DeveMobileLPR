<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="DeveMobileLPR.App.Views.DrivePage"
    x:DataType="vm:DriveViewModel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DeveMobileLPR.App.Controls"
    xmlns:vm="clr-namespace:DeveMobileLPR.App.ViewModels">
    <Grid>
        <controls:CameraPreview />

        <BoxView IsVisible="{Binding ShowStartPanel}" InputTransparent="True">
            <BoxView.Background>
                <LinearGradientBrush EndPoint="1,1">
                    <GradientStop Color="{DynamicResource DriveScrimStart}" Offset="0" />
                    <GradientStop Color="{DynamicResource DriveScrimMiddle}" Offset="0.55" />
                    <GradientStop Color="{DynamicResource DriveScrimStart}" Offset="1" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <Grid RowDefinitions="Auto,*,Auto" Style="{StaticResource DrivePageGrid}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                <Border Style="{StaticResource BrandMark}">
                    <Label Style="{StaticResource BrandMarkText}" Text="DM" />
                </Border>
                <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                        <Label FontAttributes="Bold" FontSize="17" Text="DeveMobileLPR" />
                        <Label FontSize="11" Text="PRIVATE · ON-DEVICE" TextColor="{DynamicResource TextSecondary}" />
                    </VerticalStackLayout>
                    <Border
                        AutomationId="drive_frame_intervals"
                        Grid.Column="1"
                        HorizontalOptions="End"
                        IsVisible="{Binding ShowDriveControls}"
                        Padding="12,5"
                        Style="{StaticResource DriveControlCard}"
                        VerticalOptions="Center">
                        <HorizontalStackLayout Spacing="14">
                            <VerticalStackLayout Spacing="0">
                                <Label FontAttributes="Bold" FontSize="18" Text="{Binding Diagnostics.Source.IntervalMilliseconds, Converter={StaticResource Milliseconds}}" />
                                <Label Style="{StaticResource DriveCaption}" Text="{Binding Diagnostics.Source.Label}" />
                            </VerticalStackLayout>
                            <BoxView BackgroundColor="{DynamicResource Divider}" WidthRequest="1" />
                            <VerticalStackLayout Spacing="0">
                                <Label FontAttributes="Bold" FontSize="18" Text="{Binding Diagnostics.Preview.IntervalMilliseconds, Converter={StaticResource Milliseconds}}" />
                                <Label Style="{StaticResource DriveCaption}" Text="{Binding Diagnostics.Preview.Label}" />
                            </VerticalStackLayout>
                            <BoxView BackgroundColor="{DynamicResource Divider}" WidthRequest="1" />
                            <VerticalStackLayout Spacing="0">
                                <Label FontAttributes="Bold" FontSize="18" Text="{Binding Diagnostics.Recognition.TotalMilliseconds, Converter={StaticResource Milliseconds}}" TextColor="{DynamicResource Primary}" />
                                <Label Style="{StaticResource DriveCaption}" Text="AI processing" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Border>
                </Grid>
                <Border Grid.Column="2" Stroke="{Binding StatusAccent}" Style="{StaticResource DriveStatusPill}">
                    <HorizontalStackLayout Spacing="8">
                        <Ellipse Fill="{Binding StatusAccent}" HeightRequest="8" VerticalOptions="Center" WidthRequest="8" />
                        <Label FontAttributes="Bold" FontSize="12" Text="{Binding StatusLabel}" TextColor="{Binding StatusColor}" TextTransform="Uppercase" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <Border
                x:Name="ReadyPanel"
                Grid.Row="1"
                IsVisible="{Binding ShowStartPanel}"
                Style="{StaticResource DriveReadyCard}">
                <Grid>
                    <VerticalStackLayout x:Name="ReadyPortraitContent" Spacing="18">
                    <Label Style="{StaticResource Eyebrow}" Text="Ready for the road" />
                    <Label FontAttributes="Bold" FontSize="34" LineHeight="1.05" Text="See the cars.&#10;Remember the journey." />
                    <Label Style="{StaticResource SecondaryText}" Text="Mount your phone securely before starting. Recognition and trip history stay on this device; raw video is never saved." />

                    <Grid ColumnDefinitions="*,150" ColumnSpacing="14">
                        <VerticalStackLayout Spacing="4">
                            <Label Style="{StaticResource FieldCaption}" Text="Camera" />
                            <Picker ItemsSource="{Binding CameraChoices}" SelectedItem="{Binding SelectedCamera}" Title="Select camera" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Grid ColumnDefinitions="*,Auto"><Label Style="{StaticResource FieldCaption}" Text="Zoom" /><Label Grid.Column="1" FontAttributes="Bold" Text="{Binding ZoomLabel}" TextColor="{DynamicResource Primary}" /></Grid>
                            <Slider Maximum="4" Minimum="1" Value="{Binding Zoom}" />
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout IsVisible="{Binding ShowNetworkStreamUrl}" Spacing="4">
                        <Label Style="{StaticResource FieldCaption}" Text="OME LL-HLS playlist URL" />
                        <Entry
                            AutomationId="network_stream_url"
                            ClearButtonVisibility="WhileEditing"
                            Keyboard="Url"
                            Placeholder="https://media.example/live/camera/llhls.m3u8"
                            Text="{Binding NetworkStreamUrl}" />
                    </VerticalStackLayout>

                    <Button
                        AutomationId="start_drive_button"
                        Command="{Binding ToggleDriveCommand}"
                        IsEnabled="{Binding CanStart}"
                        Text="{Binding StartButtonText}" />
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                        <ActivityIndicator IsRunning="{Binding IsInitializing}" IsVisible="{Binding IsInitializing}" />
                        <Label FontSize="12" HorizontalTextAlignment="Center" Text="{Binding Status}" TextColor="{Binding StatusColor}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <Grid x:Name="ReadyLandscapeContent" ColumnDefinitions="1.05*,*" ColumnSpacing="30" IsVisible="False">
                    <VerticalStackLayout Spacing="10" VerticalOptions="Center">
                        <Label Style="{StaticResource Eyebrow}" Text="Ready for the road" />
                        <Label FontAttributes="Bold" FontSize="29" LineHeight="1.04" Text="See the cars.&#10;Remember the journey." />
                        <Label FontSize="12" LineBreakMode="WordWrap" MaxLines="3" Text="Mount your phone securely before starting. Recognition and trip history stay on this device; raw video is never saved." TextColor="{DynamicResource TextSecondary}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="9" VerticalOptions="Center">
                        <Grid ColumnDefinitions="*,128" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="2">
                                <Label Style="{StaticResource FieldCaption}" Text="Camera" />
                                <Picker ItemsSource="{Binding CameraChoices}" SelectedItem="{Binding SelectedCamera}" Title="Select camera" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Grid ColumnDefinitions="*,Auto"><Label Style="{StaticResource FieldCaption}" Text="Zoom" /><Label Grid.Column="1" FontAttributes="Bold" Text="{Binding ZoomLabel}" TextColor="{DynamicResource Primary}" /></Grid>
                                <Slider Maximum="4" Minimum="1" Value="{Binding Zoom}" />
                            </VerticalStackLayout>
                        </Grid>
                        <Entry
                            AutomationId="network_stream_url_landscape"
                            ClearButtonVisibility="WhileEditing"
                            IsVisible="{Binding ShowNetworkStreamUrl}"
                            Keyboard="Url"
                            Placeholder="OME LL-HLS .m3u8 URL"
                            Text="{Binding NetworkStreamUrl}" />
                        <Button
                            AutomationId="start_drive_landscape_button"
                            Command="{Binding ToggleDriveCommand}"
                            IsEnabled="{Binding CanStart}"
                            Style="{StaticResource CompactButton}"
                            Text="{Binding StartButtonText}" />
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                            <ActivityIndicator IsRunning="{Binding IsInitializing}" IsVisible="{Binding IsInitializing}" />
                            <Label FontSize="11" HorizontalTextAlignment="Center" MaxLines="1" Text="{Binding Status}" TextColor="{Binding StatusColor}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                    </Grid>
                </Grid>
            </Border>

            <Grid x:Name="DriveMiddleArea" Grid.Row="1" IsVisible="{Binding ShowDriveControls}" SizeChanged="DriveMiddleAreaSizeChanged">
                <controls:DriveDiagnosticsPanel
                    x:Name="DiagnosticsPanel"
                    AutomationId="drive_processing_diagnostics"
                    BindingContext="{Binding Diagnostics}"
                    HorizontalOptions="Start"
                    IsVisible="{Binding ShowRecognitionDebug}"
                    MaximumWidthRequest="900"
                    VerticalOptions="End" />
                <Border HorizontalOptions="End" Style="{StaticResource DriveControlCard}" VerticalOptions="Start">
                    <HorizontalStackLayout Spacing="14">
                        <Picker ItemsSource="{Binding CameraChoices}" SelectedItem="{Binding SelectedCamera}" Title="Camera" WidthRequest="205" />
                        <VerticalStackLayout Spacing="0" WidthRequest="180">
                            <Grid ColumnDefinitions="*,Auto"><Label Style="{StaticResource FieldCaption}" Text="Zoom" /><Label Grid.Column="1" FontAttributes="Bold" Text="{Binding ZoomLabel}" TextColor="{DynamicResource Primary}" /></Grid>
                            <Slider Maximum="4" Minimum="1" Value="{Binding Zoom}" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="12" IsVisible="{Binding ShowDriveControls}">
                <Button
                    AutomationId="stop_drive_button"
                    Command="{Binding ToggleDriveCommand}"
                    IsEnabled="{Binding IsDriving}"
                    Style="{StaticResource DangerButton}"
                    Text="■  Stop &amp; save"
                    WidthRequest="160" />

                <Border Grid.Column="1" Style="{StaticResource DriveMetricCard}">
                    <VerticalStackLayout Spacing="0"><Label Style="{StaticResource DriveMetricValue}" Text="{Binding Duration}" /><Label Style="{StaticResource DriveCaption}" Text="Drive" /></VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource DriveMetricCard}">
                    <VerticalStackLayout Spacing="0"><Label Style="{StaticResource DriveMetricValue}" Text="{Binding UniqueVehicles}" /><Label Style="{StaticResource DriveCaption}" Text="Unique" /></VerticalStackLayout>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource DriveMetricCard}">
                    <VerticalStackLayout Spacing="0"><Label Style="{StaticResource DriveMetricValue}" Text="{Binding TopValue}" TextColor="{DynamicResource ValueAccent}" /><Label Style="{StaticResource DriveCaption}" Text="Top value" /></VerticalStackLayout>
                </Border>

                <Border Grid.Column="5" Style="{StaticResource DriveLatestCard}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border Style="{StaticResource PlateBadge}"><Label Style="{StaticResource PlateBadgeText}" Text="{Binding LatestPlate}" /></Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center"><Label FontAttributes="Bold" LineBreakMode="TailTruncation" Text="{Binding LatestVehicle}" /><Label FontSize="11" Text="{Binding LocationState}" TextColor="{DynamicResource TextSecondary}" /></VerticalStackLayout>
                        <Label Grid.Column="2" FontAttributes="Bold" Text="{Binding LatestPrice}" TextColor="{DynamicResource ValueAccent}" VerticalOptions="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
