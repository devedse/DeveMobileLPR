<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="DeveMobileLPR.App.Views.TripDetailPage"
    x:DataType="vm:TripDetailViewModel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DeveMobileLPR.App.Controls"
    xmlns:vm="clr-namespace:DeveMobileLPR.App.ViewModels">
    <Grid RowDefinitions="Auto,*" Style="{StaticResource DetailPageGrid}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
            <Button Clicked="BackClicked" Style="{StaticResource CompactSecondaryButton}" Text="‹  Back" />
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label Style="{StaticResource Eyebrow}" Text="Trip details" />
                <Label Style="{StaticResource DetailTitle}" Text="{Binding Title}" />
            </VerticalStackLayout>
            <ActivityIndicator Grid.Column="2" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" VerticalOptions="Center" />
        </Grid>

        <CollectionView
            x:Name="VehiclesList"
            Grid.Row="1"
            ItemSizingStrategy="MeasureAllItems"
            ItemsSource="{Binding Vehicles}"
            SelectionChanged="VehicleSelected"
            SelectionMode="Single">
            <CollectionView.Header>
                <VerticalStackLayout Style="{StaticResource DetailScrollContent}">
                    <Label Style="{StaticResource SecondaryText}" Text="{Binding Subtitle}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="12">
                        <Border Style="{StaticResource CompactCard}"><VerticalStackLayout Spacing="2"><Label Style="{StaticResource MetricValue}" Text="{Binding Duration}" /><Label Style="{StaticResource MetricLabel}" Text="Duration" /></VerticalStackLayout></Border>
                        <Border Grid.Column="1" Style="{StaticResource CompactCard}"><VerticalStackLayout Spacing="2"><Label Style="{StaticResource MetricValue}" Text="{Binding Distance}" /><Label Style="{StaticResource MetricLabel}" Text="Distance" /></VerticalStackLayout></Border>
                        <Border Grid.Row="1" Style="{StaticResource CompactCard}"><VerticalStackLayout Spacing="2"><Label Style="{StaticResource MetricValue}" Text="{Binding Unique}" /><Label Style="{StaticResource MetricLabel}" Text="Unique cars" /></VerticalStackLayout></Border>
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CompactHighlightCard}"><VerticalStackLayout Spacing="3"><Label FontAttributes="Bold" FontSize="22" Text="{Binding Highlight}" TextColor="{DynamicResource ValueAccent}" /><Label FontSize="12" Text="Trip highlight" TextColor="{DynamicResource HighlightText}" /></VerticalStackLayout></Border>
                    </Grid>

                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Style="{StaticResource CardContent}">
                            <controls:HistoryMapView
                                x:Name="HistoryMap"
                                HeightRequest="360"
                                IsInteractive="False"
                                Map="{Binding Map}"
                                MapRequested="MapRequested" />
                            <FlexLayout AlignItems="Center" Direction="Row" JustifyContent="Start" Wrap="Wrap">
                                <Label FlexLayout.Basis="220" FlexLayout.Grow="1" Margin="0,0,12,8" Style="{StaticResource SecondaryText}" Text="Yellow cars are first-time sightings · purple cars were seen before · mint is trip finish" VerticalOptions="Center" />
                                <Button
                                    Clicked="OpenRouteClicked"
                                    FlexLayout.Basis="220"
                                    FlexLayout.Grow="1"
                                    Margin="0,0,0,8"
                                    HorizontalOptions="End"
                                    IsVisible="{Binding HasRoute}"
                                    Style="{StaticResource CompactSecondaryButton}"
                                    Text="Open finish in Maps" />
                                    </FlexLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Style="{StaticResource SectionTitle}" Text="Vehicles on this drive" />
                            <Label Style="{StaticResource MutedText}" Text="Tap a vehicle to see every earlier sighting and location." />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="3" WidthRequest="220">
                            <Label Style="{StaticResource MutedText}" Text="SORT BY" />
                            <Picker ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" />
                        </VerticalStackLayout>
                    </Grid>
                    <SearchBar
                        Placeholder="Search plate, make, or model"
                        Text="{Binding SearchText}" />
                    <!-- The empty message stays in the header because Windows CollectionView
                         otherwise overlays EmptyView content on top of this header. -->
                    <Label
                        IsVisible="{Binding ShowVehiclesEmpty}"
                        Style="{StaticResource EmptyStateText}"
                        Text="No confirmed vehicles were recorded on this drive." />
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Vertical" ItemSpacing="10" /></CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:TripVehicleCardViewModel">
                    <Border Style="{StaticResource CompactCard}">
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                <Border MinimumWidthRequest="112" Style="{StaticResource PlateBadge}"><Label Style="{StaticResource PlateBadgeText}" Text="{Binding DisplayPlate}" /></Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label FontAttributes="Bold" Text="{Binding VehicleName}" />
                                    <Label Style="{StaticResource SettingDescription}" Text="{Binding Metadata}" />
                                    <Label Style="{StaticResource MutedText}" Text="{Binding Seen}" />
                                    <Label Style="{StaticResource MutedText}" Text="{Binding Confidence}" />
                                </VerticalStackLayout>
                                <Image
                                    Grid.Column="2"
                                    Aspect="AspectFill"
                                    HeightRequest="72"
                                    IsVisible="{Binding HasSnapshot}"
                                    Source="{Binding SnapshotSource}"
                                    WidthRequest="72" />
                            </Grid>
                            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" VerticalOptions="Center">
                                <VerticalStackLayout Spacing="2">
                                    <Label FontAttributes="Bold" Text="{Binding Price}" TextColor="{DynamicResource ValueAccent}" />
                                    <Label Style="{StaticResource SecondaryText}" Text="{Binding EarlierSightings}" />
                                    <Label Style="{StaticResource MutedText}" Text="{Binding Encounters}" />
                                </VerticalStackLayout>
                                <Button
                                    Grid.Column="1"
                                    Clicked="OpenLocationClicked"
                                    CommandParameter="{Binding Location}"
                                    IsVisible="{Binding HasLocation}"
                                    Style="{StaticResource CompactSecondaryButton}"
                                    Text="Map" />
                                <Label Grid.Column="2" FontSize="24" Text="›" TextColor="{DynamicResource TextMuted}" VerticalOptions="Center" />
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
