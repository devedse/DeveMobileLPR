<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="DeveMobileLPR.App.Views.AnalyzePage"
    x:DataType="vm:AnalyzeViewModel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DeveMobileLPR.App.Controls"
    xmlns:vm="clr-namespace:DeveMobileLPR.App.ViewModels">
    <Grid>
        <ScrollView IsVisible="{Binding ShowSetup}">
            <VerticalStackLayout Style="{StaticResource PageScrollContent}">
                <controls:PageHeader Eyebrow="Model workbench" IsBusy="{Binding IsProcessing}" Title="Analyze video" />
                <Label Style="{StaticResource SecondaryText}" Text="Process a recording privately, then inspect the sampled frames without adding test results to History." />

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Style="{StaticResource CardContent}">
                        <Label Style="{StaticResource SectionTitle}" Text="Video source" />
                        <Label LineBreakMode="MiddleTruncation" Style="{StaticResource SecondaryText}" Text="{Binding SelectedFileName}" />
                        <Button Clicked="SelectVideoClicked" IsEnabled="{Binding CanSelectVideo}" Style="{StaticResource SecondaryButton}" Text="Select video" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Style="{StaticResource CardContent}">
                        <Label Style="{StaticResource SectionTitle}" Text="Frame sampling" />
                        <Picker ItemsSource="{Binding SamplingOptions}" SelectedItem="{Binding SelectedSampling}" />
                        <Label Style="{StaticResource SecondaryText}" Text="{Binding SelectedSampling.Detail}" />
                        <Button Command="{Binding ProcessCommand}" Text="Process video" />
                    </VerticalStackLayout>
                </Border>

                <Border IsVisible="{Binding IsProcessing}" Style="{StaticResource HighlightCard}">
                    <VerticalStackLayout Style="{StaticResource CardContent}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Style="{StaticResource SectionTitle}" Text="Processing" />
                            <ActivityIndicator Grid.Column="1" IsRunning="True" />
                        </Grid>
                        <ProgressBar Progress="{Binding Progress}" ProgressColor="{DynamicResource Primary}" />
                        <Label Style="{StaticResource SecondaryText}" Text="{Binding ProgressText}" />
                        <Button Command="{Binding CancelCommand}" Style="{StaticResource CompactSecondaryButton}" Text="Cancel" />
                    </VerticalStackLayout>
                </Border>

                <Border IsVisible="{Binding HasResult}" Style="{StaticResource HighlightCard}">
                    <VerticalStackLayout Style="{StaticResource CardContent}">
                        <Label Style="{StaticResource SectionTitle}" Text="Analysis ready" />
                        <Label Style="{StaticResource SecondaryText}" Text="{Binding ResultSummary}" />
                        <Button Command="{Binding OpenReviewCommand}" Text="Open frame review" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout IsVisible="{Binding HasSavedAnalyses}" Spacing="10">
                    <Label Style="{StaticResource SectionTitle}" Text="Previous analyses" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding SavedAnalyses}" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:SavedAnalysisListItem">
                                <Border Style="{StaticResource CompactCard}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto">
                                        <Label Style="{StaticResource SettingTitle}" Text="{Binding Title}" />
                                        <Label Grid.Row="1" Style="{StaticResource MutedText}" Text="{Binding Detail}" />
                                        <Label Grid.Row="2" Style="{StaticResource MutedText}" Text="{Binding SourceStatus}" />
                                        <Button Command="{Binding OpenCommand}" Grid.Column="1" Grid.RowSpan="3" Style="{StaticResource CompactSecondaryButton}" Text="Open" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <Border Style="{StaticResource StatusCard}">
                    <Label Style="{StaticResource SecondaryText}" Text="{Binding StatusMessage}" />
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Grid IsVisible="{Binding IsReviewing}" RowDefinitions="Auto,*" Style="{StaticResource PageGrid}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button Clicked="CloseReviewClicked" Style="{StaticResource CompactSecondaryButton}" Text="Back" />
                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Style="{StaticResource SectionTitle}" Text="{Binding CurrentFrameTitle}" />
                    <Label Style="{StaticResource MutedText}" Text="{Binding CurrentFrameDetail}" />
                </VerticalStackLayout>
            </Grid>

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Spacing="12">
                    <Border BackgroundColor="#000000" Padding="0" Stroke="{DynamicResource Divider}" StrokeShape="RoundRectangle 8">
                        <Image Aspect="AspectFit" HeightRequest="360" Source="{Binding CurrentPreview}" />
                    </Border>

                    <VerticalStackLayout Spacing="2">
                        <Grid HeightRequest="34">
                            <controls:DetectionTimelineView Markers="{Binding DetectionMarkers}" VerticalOptions="Center" />
                            <Slider DragCompleted="TimelineDragCompleted" Maximum="1" Minimum="0" Value="{Binding CurrentPositionFraction, Mode=OneWay}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Label Style="{StaticResource MutedText}" Text="0:00" />
                            <Label Grid.Column="2" Style="{StaticResource MutedText}" Text="{Binding CurrentFrameTitle}" />
                        </Grid>
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding HasDetectedPlates}" Spacing="8">
                        <Label Style="{StaticResource SectionTitle}" Text="Confirmed plates" />
                        <CollectionView HeightRequest="76" ItemsSource="{Binding DetectedPlates}" ItemsLayout="HorizontalList" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:AnalyzedPlateIndexItem">
                                    <Button Command="{Binding OpenCommand}" Margin="0,0,8,0" Style="{StaticResource CompactSecondaryButton}" Text="{Binding DisplayPlate}" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <Border Style="{StaticResource CompactCard}">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding CurrentReads}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Label Style="{StaticResource SecondaryText}" Text="{Binding .}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Command="{Binding PreviousFrameCommand}" Style="{StaticResource SecondaryButton}" Text="Previous sample" />
                        <Button Command="{Binding NextFrameCommand}" Grid.Column="1" Text="Next sample" />
                    </Grid>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>