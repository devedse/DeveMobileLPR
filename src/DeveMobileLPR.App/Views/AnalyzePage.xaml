<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="DeveMobileLPR.App.Views.AnalyzePage"
    x:DataType="vm:AnalyzeViewModel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DeveMobileLPR.App.Controls"
    xmlns:vm="clr-namespace:DeveMobileLPR.App.ViewModels">
    <Grid>
        <ScrollView IsVisible="{Binding ShowSetup}">
            <VerticalStackLayout Style="{StaticResource PageScrollContent}">
                <controls:PageHeader Eyebrow="Model workbench" IsBusy="{Binding IsProcessing}" Title="Analyze video" />
                <Label Style="{StaticResource SecondaryText}" Text="Process a recording privately, then inspect the sampled frames without adding test results to History." />

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Style="{StaticResource CardContent}">
                        <Label Style="{StaticResource SectionTitle}" Text="New analysis" />
                        <Label LineBreakMode="MiddleTruncation" Style="{StaticResource SecondaryText}" Text="{Binding SelectedFileName}" />
                        <Button Clicked="SelectVideoClicked" IsEnabled="{Binding CanSelectVideo}" Style="{StaticResource SecondaryButton}" Text="Select video" />
                        <Picker ItemsSource="{Binding SamplingOptions}" SelectedItem="{Binding SelectedSampling}" />
                        <Label Style="{StaticResource SecondaryText}" Text="{Binding SelectedSamplingDetail}" />
                        <VerticalStackLayout IsVisible="{Binding UsesCustomSampling}" Spacing="4">
                            <Label Style="{StaticResource FieldCaption}" Text="Process every Nth source frame" />
                            <Entry Keyboard="Numeric" Text="{Binding CustomSamplingInterval}" />
                        </VerticalStackLayout>
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="2">
                                <Label Style="{StaticResource SettingTitle}" Text="Limit test run to 30 seconds" />
                                <Label Style="{StaticResource SettingDescription}" Text="Keeps local recognition experiments quick and repeatable." />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding LimitToFirstThirtySeconds}" VerticalOptions="Center" />
                        </Grid>
                        <Button Command="{Binding ProcessCommand}" Text="Process video" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout IsVisible="{Binding HasAnalyses}" Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Style="{StaticResource SectionTitle}" Text="Analyses" />
                        <Button Command="{Binding CancelCommand}" Grid.Column="1" IsVisible="{Binding IsProcessing}" Style="{StaticResource CompactSecondaryButton}" Text="Cancel processing" />
                    </Grid>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Analyses}" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:AnalysisListItem">
                                <Border Style="{StaticResource CompactCard}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenCommand}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" Padding="2">
                                        <controls:AnalysisProgressFillView FillColor="{DynamicResource AnalysisProgressFill}" Grid.ColumnSpan="2" Grid.RowSpan="3" IsVisible="{Binding IsProcessing}" Progress="{Binding Progress}" />
                                        <Label Style="{StaticResource SettingTitle}" Text="{Binding Title}" />
                                        <Label Grid.Row="1" Style="{StaticResource MutedText}" Text="{Binding Detail}" />
                                        <Label Grid.Row="2" Style="{StaticResource MutedText}" Text="{Binding SourceStatus}" />
                                        <Button Command="{Binding DeleteCommand}" Grid.Column="1" Grid.RowSpan="3" IsVisible="{Binding CanDelete}" SemanticProperties.Description="Delete analysis" Style="{StaticResource CompactSecondaryButton}" Text="Delete" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <Border Style="{StaticResource StatusCard}">
                    <Label Style="{StaticResource SecondaryText}" Text="{Binding StatusMessage}" />
                </Border>

                <Border IsVisible="{Binding ShowProcessingDiagnostics}" Padding="10" Style="{StaticResource DriveControlCard}">
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource FieldCaption}" Text="Live processing diagnostics" />
                        <ScrollView HorizontalScrollBarVisibility="Never" Orientation="Horizontal">
                            <controls:RecognitionDiagnosticsDetails
                                BindingContext="{Binding ProcessingDiagnostics}"
                                MinimumWidthRequest="760" />
                        </ScrollView>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Grid IsVisible="{Binding IsReviewing}" RowDefinitions="Auto,*,Auto,Auto,Auto" RowSpacing="8" Style="{StaticResource PageGrid}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button Command="{Binding CloseReviewCommand}" Style="{StaticResource CompactSecondaryButton}" Text="Back" />
                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Style="{StaticResource SectionTitle}" Text="{Binding CurrentFrameTitle}" />
                    <Label Style="{StaticResource MutedText}" Text="{Binding CurrentFrameDetail}" />
                </VerticalStackLayout>
            </Grid>

            <Border BackgroundColor="#000000" Grid.Row="1" Padding="0" Stroke="{DynamicResource Divider}" StrokeShape="RoundRectangle 8">
                <Grid>
                    <Image Aspect="AspectFit" Source="{Binding CurrentPreview}" />
                    <controls:DriveOverlayView Overlays="{Binding CurrentOverlays}" ScaleMode="Fit" />
                </Grid>
            </Border>

            <Grid Grid.Row="2" ColumnDefinitions="40,*,40" ColumnSpacing="8">
                <Button Command="{Binding PreviousFrameCommand}" FontSize="24" HeightRequest="40" Padding="0" SemanticProperties.Description="Previous frame" Style="{StaticResource CompactSecondaryButton}" Text="‹" ToolTipProperties.Text="Previous frame" WidthRequest="40" />
                <VerticalStackLayout Grid.Column="1" Spacing="0">
                    <Grid HeightRequest="30">
                        <controls:DetectionTimelineView Markers="{Binding DetectionMarkers}" VerticalOptions="Center" />
                        <controls:FrameSnapSlider DragCompleted="TimelineDragCompleted" Maximum="1" Minimum="0" SnapPoints="{Binding FramePositions}" Value="{Binding CurrentPositionFraction, Mode=TwoWay}" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Label Style="{StaticResource MutedText}" Text="0:00" />
                        <Label Grid.Column="2" Style="{StaticResource MutedText}" Text="{Binding CurrentFrameTitle}" />
                    </Grid>
                </VerticalStackLayout>
                <Button Command="{Binding NextFrameCommand}" FontSize="24" Grid.Column="2" HeightRequest="40" Padding="0" SemanticProperties.Description="Next frame" Text="›" ToolTipProperties.Text="Next frame" WidthRequest="40" />
            </Grid>

            <Grid Grid.Row="3" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <VerticalStackLayout IsVisible="{Binding HasDetectedPlates}" Spacing="4">
                    <Label Style="{StaticResource MutedText}" Text="Confirmed plates" />
                    <CollectionView HeightRequest="44" ItemsSource="{Binding DetectedPlates}" ItemsLayout="HorizontalList" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:AnalyzedPlateIndexItem">
                                <Button Command="{Binding OpenCommand}" Margin="0,0,6,0" Style="{StaticResource CompactSecondaryButton}" Text="{Binding DisplayPlate}" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
                <Border Grid.Column="1" Padding="10,6" Style="{StaticResource CompactCard}">
                    <ScrollView MaximumHeightRequest="64">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding CurrentReads}" Spacing="3">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Label Style="{StaticResource MutedText}" Text="{Binding .}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </ScrollView>
                </Border>
            </Grid>

            <Border Grid.Row="4" IsVisible="{Binding ShowCurrentDiagnostics}" Padding="10" Style="{StaticResource DriveControlCard}">
                <ScrollView HorizontalScrollBarVisibility="Never" Orientation="Horizontal">
                    <controls:RecognitionDiagnosticsDetails
                        BindingContext="{Binding CurrentFrame.Diagnostics}"
                        MinimumWidthRequest="760" />
                </ScrollView>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
