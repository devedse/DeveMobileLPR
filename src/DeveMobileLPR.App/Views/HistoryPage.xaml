<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="DeveMobileLPR.App.Views.HistoryPage"
    x:DataType="vm:HistoryViewModel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DeveMobileLPR.App.Controls"
    xmlns:vm="clr-namespace:DeveMobileLPR.App.ViewModels">
    <ContentPage.Resources>
        <Style x:Key="HistoryTabButton" BasedOn="{StaticResource CompactSecondaryButton}" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceRaised}" />
            <Setter Property="TextColor" Value="{DynamicResource TextPrimary}" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12" Style="{StaticResource PageGrid}">
        <!-- This is deliberately the only fixed content on the page. -->
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
            <Button
                Command="{Binding ShowDashboardCommand}"
                Style="{StaticResource HistoryTabButton}"
                Text="Dashboard">
                <Button.Triggers>
                    <DataTrigger Binding="{Binding ShowDashboard}" TargetType="Button" Value="True">
                        <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
                        <Setter Property="TextColor" Value="{DynamicResource OnPrimary}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button
                Grid.Column="1"
                Command="{Binding ShowTripsCommand}"
                Style="{StaticResource HistoryTabButton}"
                Text="Trips">
                <Button.Triggers>
                    <DataTrigger Binding="{Binding ShowTrips}" TargetType="Button" Value="True">
                        <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
                        <Setter Property="TextColor" Value="{DynamicResource OnPrimary}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button
                Grid.Column="2"
                Command="{Binding ShowVehiclesCommand}"
                Style="{StaticResource HistoryTabButton}"
                Text="Vehicles">
                <Button.Triggers>
                    <DataTrigger Binding="{Binding ShowVehicles}" TargetType="Button" Value="True">
                        <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
                        <Setter Property="TextColor" Value="{DynamicResource OnPrimary}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </Grid>

        <Border Grid.Row="1" IsVisible="{Binding IsTripSelectionMode}" Padding="12,8" Style="{StaticResource CompactCard}">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                <Label FontAttributes="Bold" Text="{Binding SelectedTripCount, StringFormat='{}{0} selected'}" VerticalOptions="Center" />
                <Button Clicked="CancelTripSelectionClicked" Grid.Column="1" Style="{StaticResource CompactSecondaryButton}" Text="Cancel" />
                <Button Clicked="RemoveTripsClicked" Grid.Column="2" IsEnabled="{Binding CanRemoveTrips}" Style="{StaticResource DangerButton}" Text="{Binding RemoveTripsText}" />
            </Grid>
        </Border>

        <RefreshView
            Grid.Row="2"
            Command="{Binding RefreshCommand}"
            IsRefreshing="{Binding IsBusy}"
            IsVisible="{Binding ShowDashboard}">
            <ScrollView>
                <VerticalStackLayout Padding="0,0,0,12" Spacing="16">
                    <controls:PageHeader Eyebrow="Your road journal" IsBusy="{Binding IsBusy}" Title="History" />
                    <VerticalStackLayout Spacing="2">
                        <Label Style="{StaticResource SectionTitle}" Text="Today" />
                        <Label Style="{StaticResource SecondaryText}" Text="A quick overview of today's activity." />
                    </VerticalStackLayout>
                    <controls:ResponsiveMetricGrid>
                        <Border Style="{StaticResource CompactCard}">
                            <VerticalStackLayout Spacing="2">
                                <Label Style="{StaticResource MetricValue}" Text="{Binding TodayTrips}" />
                                <Label Style="{StaticResource MetricLabel}" Text="Drives today" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Style="{StaticResource CompactCard}">
                            <VerticalStackLayout Spacing="2">
                                <Label Style="{StaticResource MetricValue}" Text="{Binding TodayUnique}" />
                                <Label Style="{StaticResource MetricLabel}" Text="Unique cars" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Style="{StaticResource CompactCard}">
                            <VerticalStackLayout Spacing="2">
                                <Label Style="{StaticResource MetricValue}" Text="{Binding TodayDistance}" />
                                <Label Style="{StaticResource MetricLabel}" Text="Route distance" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Style="{StaticResource CompactHighlightCard}">
                            <VerticalStackLayout Spacing="3">
                                <Label FontAttributes="Bold" FontSize="25" Text="{Binding TodayTopValue}" TextColor="{DynamicResource ValueAccent}" />
                                <Label FontSize="12" Text="Most expensive today" TextColor="{DynamicResource HighlightText}" />
                                <Border HorizontalOptions="Start" Style="{StaticResource SmallPlateBadge}">
                                    <Label Style="{StaticResource SmallPlateBadgeText}" Text="{Binding TodayTopPlate}" />
                                </Border>
                            </VerticalStackLayout>
                        </Border>
                    </controls:ResponsiveMetricGrid>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <RefreshView
            Grid.Row="2"
            Command="{Binding RefreshCommand}"
            IsRefreshing="{Binding IsBusy}"
            IsVisible="{Binding ShowTrips}">
            <CollectionView
                x:Name="TripsList"
                ItemSizingStrategy="MeasureAllItems"
                ItemsSource="{Binding Trips}"
                RemainingItemsThreshold="5"
                RemainingItemsThresholdReachedCommand="{Binding LoadMoreTripsCommand}"
                SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout ItemSpacing="10" Orientation="Vertical" />
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <Border IsVisible="{Binding ShowTripsEmpty}" Margin="0,4,0,0" Style="{StaticResource CompactCard}" VerticalOptions="Start">
                        <VerticalStackLayout Spacing="3">
                            <Label Style="{StaticResource SettingTitle}" Text="No drives yet" />
                            <Label Style="{StaticResource SecondaryText}" Text="Your completed drives will appear here." />
                        </VerticalStackLayout>
                    </Border>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:TripCardViewModel">
                        <Border Style="{StaticResource CompactCard}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <CheckBox
                                    IsChecked="{Binding IsSelected}"
                                    IsVisible="{Binding ShowSelectionCheckbox}"
                                    VerticalOptions="Center" />
                                <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="10">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer CommandParameter="{Binding .}" Tapped="TripTapped" />
                                    <PointerGestureRecognizer
                                        PointerExited="TripPointerReleased"
                                        PointerPressed="TripPointerPressed"
                                        PointerReleased="TripPointerReleased" />
                                </Grid.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20">
                                    <VerticalStackLayout Spacing="2" WidthRequest="105">
                                        <Label FontAttributes="Bold" FontSize="18" Text="{Binding Day}" />
                                        <Label Style="{StaticResource SecondaryText}" Text="{Binding Time}" />
                                    </VerticalStackLayout>
                                    <Grid Grid.Column="1" ColumnDefinitions="*,*,*" ColumnSpacing="14" VerticalOptions="Center">
                                        <VerticalStackLayout Spacing="1">
                                            <Label FontAttributes="Bold" Text="{Binding Duration}" />
                                            <Label Style="{StaticResource MutedText}" Text="DURATION" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="1">
                                            <Label FontAttributes="Bold" Text="{Binding Distance}" />
                                            <Label Style="{StaticResource MutedText}" Text="DISTANCE" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="2" Spacing="1">
                                            <Label FontAttributes="Bold" Text="{Binding VehicleCount}" />
                                            <Label Style="{StaticResource MutedText}" Text="VEHICLES" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Grid>
                                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                                    <VerticalStackLayout Spacing="2">
                                        <Label FontAttributes="Bold" Text="{Binding Highlight}" TextColor="{DynamicResource ValueAccent}" />
                                        <Label Style="{StaticResource MutedText}" Text="{Binding HighlightPlate}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" FontSize="24" Text="›" TextColor="{DynamicResource TextMuted}" VerticalOptions="Center" />
                                </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <RefreshView
            Grid.Row="2"
            Command="{Binding RefreshCommand}"
            IsRefreshing="{Binding IsBusy}"
            IsVisible="{Binding ShowVehicles}">
            <CollectionView
                x:Name="VehiclesList"
                ItemSizingStrategy="MeasureAllItems"
                ItemsSource="{Binding Vehicles}"
                RemainingItemsThreshold="5"
                RemainingItemsThresholdReachedCommand="{Binding LoadMoreVehiclesCommand}"
                SelectionChanged="VehicleSelected"
                SelectionMode="Single">
                <CollectionView.Header>
                    <!-- A CollectionView header shares the list's scroll surface, so filters
                         move out of the way while the tab selector remains available. -->
                    <VerticalStackLayout Padding="0,0,0,12" Spacing="10">
                        <SearchBar Placeholder="Search plate, make, or model" Text="{Binding SearchText}" />
                        <FlexLayout AlignItems="Stretch" Direction="Row" JustifyContent="Start" Wrap="Wrap">
                            <VerticalStackLayout FlexLayout.Basis="145" FlexLayout.Grow="1" Margin="0,0,10,8" Spacing="3">
                                <Label Style="{StaticResource MutedText}" Text="SEEN WITHIN" />
                                <Picker ItemsSource="{Binding PeriodOptions}" SelectedItem="{Binding SelectedPeriod}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout FlexLayout.Basis="145" FlexLayout.Grow="1" Margin="0,0,10,8" Spacing="3">
                                <Label Style="{StaticResource MutedText}" Text="VALUE" />
                                <Picker ItemsSource="{Binding MinimumValueOptions}" SelectedItem="{Binding SelectedMinimumValue}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout FlexLayout.Basis="145" FlexLayout.Grow="1" Margin="0,0,0,8" Spacing="3">
                                <Label Style="{StaticResource MutedText}" Text="SORT BY" />
                                <Picker ItemsSource="{Binding VehicleSortOptions}" SelectedItem="{Binding SelectedVehicleSort}" />
                            </VerticalStackLayout>
                        </FlexLayout>
                        <Border IsVisible="{Binding ShowVehiclesEmpty}" Margin="0,4,0,0" Style="{StaticResource CompactCard}" VerticalOptions="Start">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="3">
                                    <Label Style="{StaticResource SettingTitle}" Text="No vehicles found" />
                                    <Label Style="{StaticResource SecondaryText}" Text="No confirmed vehicles match the current search and filters." />
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Command="{Binding ResetVehicleFiltersCommand}" Style="{StaticResource CompactSecondaryButton}" Text="Reset filters" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </CollectionView.Header>
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout ItemSpacing="10" Orientation="Vertical" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:VehicleCardViewModel">
                        <Border Style="{StaticResource CompactCard}">
                            <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                    <Border MinimumWidthRequest="112" Style="{StaticResource PlateBadge}">
                                        <Label Style="{StaticResource PlateBadgeText}" Text="{Binding DisplayPlate}" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label FontAttributes="Bold" Text="{Binding VehicleName}" />
                                        <Label Style="{StaticResource SettingDescription}" Text="{Binding Metadata}" />
                                        <Label Style="{StaticResource MutedText}" Text="{Binding Seen}" />
                                    </VerticalStackLayout>
                                    <Image
                                        Grid.Column="2"
                                        Aspect="AspectFill"
                                        HeightRequest="72"
                                        IsVisible="{Binding HasSnapshot}"
                                        Source="{Binding SnapshotSource}"
                                        WidthRequest="72" />
                                </Grid>
                                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                                    <VerticalStackLayout Spacing="2">
                                        <Label FontAttributes="Bold" Text="{Binding Price}" TextColor="{DynamicResource ValueAccent}" />
                                        <Label Style="{StaticResource SecondaryText}" Text="{Binding History}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" FontSize="24" Text="›" TextColor="{DynamicResource TextMuted}" VerticalOptions="Center" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
