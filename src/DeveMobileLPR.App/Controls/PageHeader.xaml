<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="DeveMobileLPR.App.Controls.PageHeader"
    x:DataType="controls:PageHeader"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DeveMobileLPR.App.Controls">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <VerticalStackLayout Spacing="2">
            <Label Style="{StaticResource Eyebrow}" Text="{Binding Eyebrow, Source={x:Reference Root}}" />
            <Label Style="{StaticResource PageTitle}" Text="{Binding Title, Source={x:Reference Root}}" />
        </VerticalStackLayout>
        <ActivityIndicator
            Grid.Column="1"
            IsRunning="{Binding IsBusy, Source={x:Reference Root}}"
            IsVisible="{Binding IsBusy, Source={x:Reference Root}}"
            VerticalOptions="Center" />
    </Grid>
</ContentView>
