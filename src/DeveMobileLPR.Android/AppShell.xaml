<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="DeveMobileLPR.AndroidApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False"
    Shell.BackgroundColor="{DynamicResource Surface}"
    Shell.ForegroundColor="{DynamicResource TextPrimary}"
    Shell.TabBarBackgroundColor="{DynamicResource Surface}"
    Shell.TabBarForegroundColor="{DynamicResource Primary}"
    Shell.TabBarTitleColor="{DynamicResource Primary}"
    Shell.TabBarUnselectedColor="{DynamicResource TextMuted}" />
