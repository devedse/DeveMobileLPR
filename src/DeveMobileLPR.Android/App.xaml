<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="DeveMobileLPR.AndroidApp.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="Background">#0B0D10</Color>
            <Color x:Key="Surface">#151922</Color>
            <Color x:Key="SurfaceRaised">#202632</Color>
            <Color x:Key="SurfaceMuted">#2A303B</Color>
            <Color x:Key="Primary">#58E0C2</Color>
            <Color x:Key="PrimaryDark">#1A6659</Color>
            <Color x:Key="PlateYellow">#F5C542</Color>
            <Color x:Key="TextPrimary">#F7F9FC</Color>
            <Color x:Key="TextSecondary">#AAB3C2</Color>
            <Color x:Key="TextMuted">#747E8E</Color>
            <Color x:Key="Danger">#FF6B6B</Color>
            <Color x:Key="Success">#58E0C2</Color>
            <Color x:Key="Divider">#303744</Color>

            <Style TargetType="ContentPage">
                <Setter Property="BackgroundColor" Value="{StaticResource Background}" />
                <Setter Property="Shell.NavBarIsVisible" Value="False" />
            </Style>
            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="FontSize" Value="15" />
            </Style>
            <Style x:Key="PageTitle" TargetType="Label">
                <Setter Property="FontSize" Value="30" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="LineBreakMode" Value="TailTruncation" />
            </Style>
            <Style x:Key="SectionTitle" TargetType="Label">
                <Setter Property="FontSize" Value="19" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>
            <Style x:Key="Eyebrow" TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CharacterSpacing" Value="1.2" />
                <Setter Property="TextColor" Value="{StaticResource Primary}" />
                <Setter Property="TextTransform" Value="Uppercase" />
            </Style>
            <Style x:Key="SecondaryText" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
                <Setter Property="FontSize" Value="14" />
            </Style>
            <Style x:Key="MetricValue" TargetType="Label">
                <Setter Property="FontSize" Value="27" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                <Setter Property="TextColor" Value="#07110F" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="HeightRequest" Value="54" />
                <Setter Property="Padding" Value="22,12" />
            </Style>
            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceRaised}" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
            </Style>
            <Style x:Key="DangerButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Danger}" />
                <Setter Property="TextColor" Value="#180606" />
            </Style>
            <Style TargetType="SearchBar">
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceRaised}" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource TextMuted}" />
                <Setter Property="CancelButtonColor" Value="{StaticResource Primary}" />
            </Style>
            <Style TargetType="Switch">
                <Setter Property="OnColor" Value="{StaticResource Primary}" />
                <Setter Property="ThumbColor" Value="{StaticResource TextPrimary}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
