<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="DeveMobileLPR.AndroidApp.Views.TripDetailPage"
    x:DataType="vm:TripDetailViewModel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DeveMobileLPR.AndroidApp.Controls"
    xmlns:vm="clr-namespace:DeveMobileLPR.AndroidApp.ViewModels">
    <Grid RowDefinitions="Auto,*" Style="{StaticResource DetailPageGrid}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
            <Button Clicked="BackClicked" Style="{StaticResource CompactSecondaryButton}" Text="‹  Back" />
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label Style="{StaticResource Eyebrow}" Text="Trip details" />
                <Label Style="{StaticResource DetailTitle}" Text="{Binding Title}" />
            </VerticalStackLayout>
            <ActivityIndicator Grid.Column="2" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" VerticalOptions="Center" />
        </Grid>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Sightings}" SelectionMode="None">
            <CollectionView.Header>
                <VerticalStackLayout Style="{StaticResource DetailScrollContent}">
                    <Label Style="{StaticResource SecondaryText}" Text="{Binding Subtitle}" />

                    <controls:ResponsiveGrid ColumnSpacing="12" MaximumColumns="4" MinimumItemWidth="145" RowSpacing="12">
                        <Border Style="{StaticResource CompactCard}"><VerticalStackLayout Spacing="2"><Label Style="{StaticResource MetricValue}" Text="{Binding Duration}" /><Label Style="{StaticResource MetricLabel}" Text="Duration" /></VerticalStackLayout></Border>
                        <Border Style="{StaticResource CompactCard}"><VerticalStackLayout Spacing="2"><Label Style="{StaticResource MetricValue}" Text="{Binding Distance}" /><Label Style="{StaticResource MetricLabel}" Text="Distance" /></VerticalStackLayout></Border>
                        <Border Style="{StaticResource CompactCard}"><VerticalStackLayout Spacing="2"><Label Style="{StaticResource MetricValue}" Text="{Binding Unique}" /><Label Style="{StaticResource MetricLabel}" Text="Unique cars" /></VerticalStackLayout></Border>
                        <Border Style="{StaticResource CompactHighlightCard}"><VerticalStackLayout Spacing="3"><Label FontAttributes="Bold" FontSize="22" Text="{Binding Highlight}" TextColor="{StaticResource PlateYellow}" /><Label FontSize="12" Text="Trip highlight" TextColor="{StaticResource HighlightText}" /></VerticalStackLayout></Border>
                    </controls:ResponsiveGrid>

                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Style="{StaticResource CardContent}">
                            <controls:TripRouteView Points="{Binding Points}" />
                            <controls:ResponsiveGrid ColumnSpacing="12" MaximumColumns="2" MinimumItemWidth="220" RowSpacing="8">
                                <Label Style="{StaticResource SecondaryText}" Text="Offline route trace · yellow is start, mint is finish" VerticalOptions="Center" />
                                <Button
                                    Clicked="OpenRouteClicked"
                                    HorizontalOptions="End"
                                    IsVisible="{Binding HasRoute}"
                                    Style="{StaticResource CompactSecondaryButton}"
                                    Text="Open finish in Maps" />
                            </controls:ResponsiveGrid>
                        </VerticalStackLayout>
                    </Border>

                    <Label Style="{StaticResource SectionTitle}" Text="Vehicles on this drive" />
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Vertical" ItemSpacing="10" /></CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:SightingCardViewModel">
                    <Border Style="{StaticResource CompactCard}">
                        <controls:ResponsiveGrid ColumnSpacing="18" MaximumColumns="2" MinimumItemWidth="245" RowSpacing="10">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                <Border MinimumWidthRequest="112" Style="{StaticResource PlateBadge}"><Label Style="{StaticResource PlateBadgeText}" Text="{Binding DisplayPlate}" /></Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label FontAttributes="Bold" Text="{Binding VehicleName}" />
                                    <Label Style="{StaticResource SettingDescription}" Text="{Binding Metadata}" />
                                    <Label Style="{StaticResource MutedText}" Text="{Binding Confidence}" />
                                </VerticalStackLayout>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                                <VerticalStackLayout Spacing="2">
                                    <Label FontAttributes="Bold" Text="{Binding Price}" TextColor="{StaticResource PlateYellow}" />
                                    <Label Style="{StaticResource MutedText}" Text="{Binding Seen}" />
                                </VerticalStackLayout>
                                <Button
                                    Grid.Column="1"
                                    Clicked="OpenLocationClicked"
                                    CommandParameter="{Binding Location}"
                                    IsVisible="{Binding HasLocation}"
                                    Style="{StaticResource CompactSecondaryButton}"
                                    Text="Map" />
                            </Grid>
                        </controls:ResponsiveGrid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label Style="{StaticResource EmptyStateText}" Text="No confirmed vehicles were recorded on this drive." />
            </CollectionView.EmptyView>
        </CollectionView>
    </Grid>
</ContentPage>
