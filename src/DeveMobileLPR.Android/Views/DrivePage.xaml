<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="DeveMobileLPR.AndroidApp.Views.DrivePage"
    x:DataType="vm:DriveViewModel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DeveMobileLPR.AndroidApp.Controls"
    xmlns:vm="clr-namespace:DeveMobileLPR.AndroidApp.ViewModels"
    Shell.NavBarIsVisible="False">
    <Grid>
        <controls:CameraPreview />

        <BoxView IsVisible="{Binding ShowStartPanel}" InputTransparent="True">
            <BoxView.Background>
                <LinearGradientBrush EndPoint="1,1">
                    <GradientStop Color="#F20B0D10" Offset="0" />
                    <GradientStop Color="#C911151B" Offset="0.55" />
                    <GradientStop Color="#F20B0D10" Offset="1" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <Grid Padding="24,18" RowDefinitions="Auto,*,Auto">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                <Border BackgroundColor="{StaticResource PlateYellow}" Padding="11,7" StrokeThickness="0" StrokeShape="RoundRectangle 10">
                    <Label FontAttributes="Bold" FontSize="14" Text="RL" TextColor="#111318" />
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                    <Label FontAttributes="Bold" FontSize="17" Text="RoadLens" />
                    <Label FontSize="11" Text="PRIVATE · ON-DEVICE" TextColor="{StaticResource TextSecondary}" />
                </VerticalStackLayout>
                <Border Grid.Column="2" BackgroundColor="#D9161A21" Padding="12,7" Stroke="{Binding StatusAccent}" StrokeThickness="1" StrokeShape="RoundRectangle 16">
                    <HorizontalStackLayout Spacing="8">
                        <Ellipse Fill="{Binding StatusAccent}" HeightRequest="8" VerticalOptions="Center" WidthRequest="8" />
                        <Label FontAttributes="Bold" FontSize="12" Text="{Binding StatusLabel}" TextColor="{Binding StatusColor}" TextTransform="Uppercase" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <Border
                Grid.Row="1"
                IsVisible="{Binding ShowStartPanel}"
                MaximumWidthRequest="570"
                Padding="30"
                BackgroundColor="#F0151922"
                HorizontalOptions="Center"
                Stroke="{StaticResource Divider}"
                StrokeShape="RoundRectangle 28"
                VerticalOptions="Center">
                <VerticalStackLayout Spacing="18">
                    <Label Style="{StaticResource Eyebrow}" Text="Ready for the road" />
                    <Label FontAttributes="Bold" FontSize="34" LineHeight="1.05" Text="See the cars.&#10;Remember the journey." />
                    <Label Style="{StaticResource SecondaryText}" Text="Mount your phone securely before starting. Recognition and trip history stay on this device; raw video is never saved." />

                    <Grid ColumnDefinitions="*,150" ColumnSpacing="14">
                        <VerticalStackLayout Spacing="4">
                            <Label FontSize="11" Text="CAMERA" TextColor="{StaticResource TextMuted}" />
                            <Picker ItemsSource="{Binding CameraChoices}" SelectedItem="{Binding SelectedCamera}" TextColor="{StaticResource TextPrimary}" Title="Select camera" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Grid ColumnDefinitions="*,Auto"><Label FontSize="11" Text="ZOOM" TextColor="{StaticResource TextMuted}" /><Label Grid.Column="1" FontAttributes="Bold" Text="{Binding ZoomLabel}" TextColor="{StaticResource Primary}" /></Grid>
                            <Slider Maximum="4" Minimum="1" ThumbColor="{StaticResource Primary}" Value="{Binding Zoom}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Button
                        AutomationId="start_drive_button"
                        Command="{Binding ToggleDriveCommand}"
                        IsEnabled="{Binding CanStart}"
                        Text="{Binding StartButtonText}" />
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                        <ActivityIndicator IsRunning="{Binding IsInitializing}" IsVisible="{Binding IsInitializing}" Color="{StaticResource Primary}" />
                        <Label FontSize="12" HorizontalTextAlignment="Center" Text="{Binding Status}" TextColor="{Binding StatusColor}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Grid Grid.Row="1" IsVisible="{Binding ShowDriveControls}">
                <Border BackgroundColor="#D911151B" HorizontalOptions="End" Padding="14,10" Stroke="{StaticResource Divider}" StrokeShape="RoundRectangle 18" VerticalOptions="Start">
                    <HorizontalStackLayout Spacing="14">
                        <Picker ItemsSource="{Binding CameraChoices}" SelectedItem="{Binding SelectedCamera}" TextColor="White" Title="Camera" WidthRequest="205" />
                        <VerticalStackLayout Spacing="0" WidthRequest="180">
                            <Grid ColumnDefinitions="*,Auto"><Label FontSize="11" Text="ZOOM" TextColor="{StaticResource TextSecondary}" /><Label Grid.Column="1" FontAttributes="Bold" Text="{Binding ZoomLabel}" TextColor="{StaticResource Primary}" /></Grid>
                            <Slider Maximum="4" Minimum="1" ThumbColor="{StaticResource Primary}" Value="{Binding Zoom}" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="12" IsVisible="{Binding ShowDriveControls}">
                <Button
                    AutomationId="stop_drive_button"
                    Command="{Binding ToggleDriveCommand}"
                    IsEnabled="{Binding IsDriving}"
                    Style="{StaticResource DangerButton}"
                    Text="■  Stop &amp; save"
                    WidthRequest="160" />

                <Border Grid.Column="1" BackgroundColor="#E0151922" Padding="14,8" StrokeThickness="0" StrokeShape="RoundRectangle 16" WidthRequest="92">
                    <VerticalStackLayout Spacing="0"><Label FontAttributes="Bold" FontSize="22" Text="{Binding Duration}" /><Label FontSize="10" Text="DRIVE" TextColor="{StaticResource TextSecondary}" /></VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" BackgroundColor="#E0151922" Padding="14,8" StrokeThickness="0" StrokeShape="RoundRectangle 16" WidthRequest="92">
                    <VerticalStackLayout Spacing="0"><Label FontAttributes="Bold" FontSize="22" Text="{Binding UniqueVehicles}" /><Label FontSize="10" Text="UNIQUE" TextColor="{StaticResource TextSecondary}" /></VerticalStackLayout>
                </Border>
                <Border Grid.Column="3" BackgroundColor="#E0151922" Padding="14,8" StrokeThickness="0" StrokeShape="RoundRectangle 16" WidthRequest="92">
                    <VerticalStackLayout Spacing="0"><Label FontAttributes="Bold" FontSize="22" Text="{Binding TopValue}" TextColor="{StaticResource PlateYellow}" /><Label FontSize="10" Text="TOP VALUE" TextColor="{StaticResource TextSecondary}" /></VerticalStackLayout>
                </Border>

                <Border Grid.Column="5" BackgroundColor="#EB151922" Padding="15,8" Stroke="{StaticResource Divider}" StrokeShape="RoundRectangle 16" WidthRequest="330">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border BackgroundColor="{StaticResource PlateYellow}" Padding="10,5" StrokeThickness="0" StrokeShape="RoundRectangle 7" VerticalOptions="Center"><Label FontAttributes="Bold" FontSize="16" Text="{Binding LatestPlate}" TextColor="#111318" /></Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center"><Label FontAttributes="Bold" LineBreakMode="TailTruncation" Text="{Binding LatestVehicle}" /><Label FontSize="11" Text="{Binding LocationState}" TextColor="{StaticResource TextSecondary}" /></VerticalStackLayout>
                        <Label Grid.Column="2" FontAttributes="Bold" Text="{Binding LatestPrice}" TextColor="{StaticResource PlateYellow}" VerticalOptions="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
